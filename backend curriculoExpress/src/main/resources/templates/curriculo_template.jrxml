<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="curriculo" pageWidth="595" pageHeight="842" columnWidth="555">

    <parameter name="nome" class="java.lang.String"/>
    <parameter name="email" class="java.lang.String"/>
    <parameter name="telefone" class="java.lang.String"/>
    <parameter name="socialMedia" class="java.lang.String"/>
    <parameter name="universityName" class="java.lang.String"/>
    <parameter name="courseAndSemester" class="java.lang.String"/>
    <parameter name="lastCompany" class="java.lang.String"/>
    <parameter name="lastActivities" class="java.lang.String"/>
    <parameter name="extraExperience" class="java.lang.String"/>

    <detail>
        <band height="200">
            <textField>
                <reportElement x="20" y="20" width="500" height="20"/>
                <textFieldExpression><![CDATA["Nome: " + $P{nome}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="40" width="500" height="20"/>
                <textFieldExpression><![CDATA["Email: " + $P{email}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="60" width="500" height="20"/>
                <textFieldExpression><![CDATA["Telefone: " + $P{telefone}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="80" width="500" height="20"/>
                <textFieldExpression><![CDATA["Rede Social: " + $P{socialMedia}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="100" width="500" height="20"/>
                <textFieldExpression><![CDATA["Universidade: " + $P{universityName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="120" width="500" height="20"/>
                <textFieldExpression><![CDATA["Curso e Semestre: " + $P{courseAndSemester}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="140" width="500" height="20"/>
                <textFieldExpression><![CDATA["Última Empresa: " + $P{lastCompany}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="160" width="500" height="20"/>
                <textFieldExpression><![CDATA["Atividades na Empresa: " + $P{lastActivities}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="20" y="180" width="500" height="20"/>
                <textFieldExpression><![CDATA["Experiência Adicional: " + $P{extraExperience}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>
